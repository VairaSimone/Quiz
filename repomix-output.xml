<file path="backend/prisma/schema.prisma">
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Section {
  id          String       @id @default(uuid())
  title       String       @unique
  description String?
  coverImage  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  questions   Question[]
  gameResults GameResult[]
}

model Question {
  id            String   @id @default(uuid())
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type          String   @default("MULTIPLE_CHOICE")
  level         String   @default("MEDIO")
  questionText  String
  correctAnswer String
  options       Option[]
  createdAt     DateTime @default(now())
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
}

model GameResult {
  id             String   @id @default(uuid())
  sectionId      String
  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  playerName     String   @default("Anonimo")
  score          Int
  totalQuestions Int
  playedAt       DateTime @default(now())
}

model Story {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  coverImage  String?
  jsonUrl     String?
  content     Json?   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
